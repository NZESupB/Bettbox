{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "KitonyBox Windows Dev",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "program": "lib/main.dart",
      "deviceId": "windows",
      "toolArgs": [
        "--dart-define",
        "APP_DEV=true"
      ],
      "preLaunchTask": "kitonybox: ensure windows dev core"
    },
